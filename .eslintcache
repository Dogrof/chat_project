l, pass })).then(() => {\r\n      props.history.push(\"/\");\r\n    });\r\n  };\r\n\r\n  return (\r\n    <div\r\n      className=\"main-container\"\r\n      style={{\r\n        backgroundImage: \"url(\" + main_back + \")\",\r\n        backgroundRepeat: \"no-repeat\",\r\n        backgroundPosition: \"center\",\r\n        backgroundSize: \"cover\",\r\n      }}\r\n    >\r\n      <div className=\"inner-container\">\r\n        <h1>Welcome to Chat</h1>\r\n        <p>\r\n          Lorem ipsum dolor sit amet, consectetur <br /> adipiscing elit.{\" \"}\r\n        </p>\r\n        <form autocomplete=\"off\" action=\"/\" method=\"post\" onSubmit={handleSubmit}>\r\n          <div className=\"field-wrap\">\r\n            <input\r\n              type=\"text\"\r\n              required\r\n              autocomplete=\"off\"\r\n              placeholder=\"Login\"\r\n              value={mail}\r\n              onChange={(e) => setMail(e.target.value)}\r\n            />\r\n          </div>\r\n          <div className=\"field-wrap\">\r\n            <input\r\n              type=\"password\"\r\n              required\r\n              autocomplete=\"off\"\r\n              placeholder=\"Password\"\r\n              value={pass}\r\n              onChange={(e) => setPass(e.target.value)}\r\n            />\r\n          </div>\r\n          <div className=\"checkbox\">\r\n            <input type=\"checkbox\" defaultChecked=\"checked\" />\r\n            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. </p>\r\n          </div>\r\n          <button type=\"submit\">Go</button>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\n// export default axios.create({\r\n//     baseURL: \"https://randomuser.me/api/\",\r\n//     responseType: \"json\"\r\n//   });\r\n\r\nexport default SignIn;\r\n","D:\\Work\\Chat Proj\\chat_project\\src\\components\\groups.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\components\\chat.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\components\\sidebar.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\store\\store.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\pages\\HomePage.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\store\\reducers\\index.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\store\\actions\\user.js",["85"],"import userApi from \"../../services/api/userApi\";\r\nimport axios from \"../../services/api/axios_conf\";\r\nimport socketInit from \"./socket-init.js\";\r\nimport browserHistory from 'history/createBrowserHistory'\r\n\r\n\r\nconst setUser = (data) => ({\r\n  type: \"SET_USER\",\r\n  payload: data,\r\n});\r\n\r\nconst setUserCurrentDialog = (data) => ({\r\n  type: \"SET_USER_CURRENT_DIALOG\",\r\n  payload: data,\r\n});\r\n\r\nexport const loginAction = (credentials) => (dispatch) => {\r\n  return userApi\r\n    .login(credentials)\r\n    .then(({ data }) => {\r\n      const { access_token } = data;\r\n      window.localStorage.TOKEN = access_token;\r\n      axios.defaults.headers.common[\"Authorization\"] = `Bearer ${access_token}`;\r\n    })\r\n    .then(() => {\r\n      userApi.getUser().then((data) => {\r\n        console.log(data);\r\n        dispatch(setUser(data));\r\n        dispatch(socketInit());\r\n      });\r\n    })\r\n    .then(() => {\r\n      userApi.setChatInfo().then((data) => {\r\n        if (data) {\r\n          browserHistory.push('/chat')\r\n        }else{\r\n          browserHistory.push('/join')\r\n        }\r\n      });\r\n    });\r\n};\r\n","D:\\Work\\Chat Proj\\chat_project\\src\\store\\reducers\\user.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\services\\api\\axios_conf.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\services\\api\\userApi.js",["86"],"import axios from \"../api/axios_conf\";\r\n\r\nconst userApi = {\r\n  login: ({ mail, pass }) => {\r\n    return axios\r\n      .post(\"/auth/login\", { email: mail, password: pass })\r\n      .then((data) => {\r\n        return data;\r\n      })\r\n      .catch((err) => {\r\n        console.log(err);\r\n      });\r\n  },\r\n  getUser: () => {\r\n    return axios\r\n      .get(\"/user\")\r\n      .then(({ data }) => {\r\n        return data;\r\n      })\r\n      .catch((err) => {\r\n        console.log(err);\r\n      });\r\n  },\r\n  setChatInfo: (id) => {\r\n    return axios\r\n    axios.post('/client/chat/join', {type:id}).then(data => {\r\n\r\n\r\n      return data;\r\n      //\r\n    }).catch(err =>{\r\n      console.log(\"Response error\");\r\n    })\r\n  },\r\n};\r\n\r\nexport default userApi;\r\n","D:\\Work\\Chat Proj\\chat_project\\src\\components\\join.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\store\\reducers\\chat.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\store\\actions\\chat.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\middlewares\\AuthMiddleware.js",[],"D:\\Work\\Chat Proj\\chat_project\\src\\store\\actions\\socket-init.js",[],{"ruleId":"87","replacedBy":"88"},{"ruleId":"89","replacedBy":"90"},{"ruleId":"91","severity":1,"message":"92","line":2,"column":20,"nodeType":"93","messageId":"94","endLine":2,"endColumn":29},{"ruleId":"91","severity":1,"message":"95","line":12,"column":7,"nodeType":"93","messageId":"94","endLine":12,"endColumn":27},{"ruleId":"96","severity":1,"message":"97","line":26,"column":5,"nodeType":"98","messageId":"99","endLine":33,"endColumn":7},"no-native-reassign",["100"],"no-negated-in-lhs",["101"],"no-unused-vars","'useEffect' is defined but never used.","Identifier","unusedVar","'setUserCurrentDialog' is assigned a value but never used.","no-unreachable","Unreachable code.","ExpressionStatement","unreachableCode","no-global-assign","no-unsafe-negation"]