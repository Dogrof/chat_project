top/chat_project/src/components/MessagesList.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/ChatInput.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/Join.js",["109"],"import React, { useEffect } from 'react';\nimport axios from '../services/api/axios_conf';\nimport { setChatInfo } from '../store/actions/chat';\nimport { useDispatch } from 'react-redux';\nimport joinBg from '../images/join-bg.png';\nlet chatTypes = [\n  {\n    _id: '234',\n    name: 'Admin',\n  },\n  {\n    _id: '123',\n    name: 'General',\n  },\n];\n\nfunction Join(props) {\n  const dispatch = useDispatch();\n  // const [chatTypes, setchatTypes] = useState([]);\n  // useEffect(() => {\n  //     // Обновляем заголовок документа с помощью API браузера\n  //     axios.get('/api/chat-types')\n  //     .then(res => {\n  //       const chatTypes = res.data;\n  //       setchatTypes( chatTypes );\n  //     })\n  //   });\n\n  const handleCLick = (e) => {\n    axios\n      .post('/client/chat/join', { type: e.target.id })\n      .then((data) => {\n        dispatch(setChatInfo(data));\n        props.history.push('/chat');\n      })\n      .catch((err) => {\n        console.log('Response error');\n      });\n  };\n\n  return (\n    <div className='join' style={{ backgroundImage: `url(${joinBg})` }}>\n      <div className='join__inner'>\n        <h1 className='join__title'>Welcome to Chat</h1>\n        <p className='join__text'>\n          Lorem ipsum dolor sit amet, consectetur adipiscing elit\n        </p>\n        <div className='join__buttons'></div>\n        {chatTypes.map((type) => {\n          return (\n            <button\n              key={type._id}\n              name={type.name}\n              id={type._id}\n              onClick={handleCLick}\n              className='btn'\n            >\n              {type.name}\n            </button>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n\nexport default Join;\n","/Users/vovanguyen/Desktop/chat_project/src/components/Avatar.js",[],{"ruleId":"110","severity":1,"message":"111","line":3,"column":9,"nodeType":"112","messageId":"113","endLine":3,"endColumn":18},{"ruleId":"110","severity":1,"message":"114","line":3,"column":9,"nodeType":"112","messageId":"113","endLine":3,"endColumn":23},{"ruleId":"110","severity":1,"message":"115","line":10,"column":7,"nodeType":"112","messageId":"113","endLine":10,"endColumn":27},{"ruleId":"116","replacedBy":"117"},{"ruleId":"118","replacedBy":"119"},{"ruleId":"110","severity":1,"message":"111","line":1,"column":17,"nodeType":"112","messageId":"113","endLine":1,"endColumn":26},"no-unused-vars","'useEffect' is defined but never used.","Identifier","unusedVar","'browserHistory' is defined but never used.","'setUserCurrentDialog' is assigned a value but never used.","no-native-reassign",["120"],"no-negated-in-lhs",["121"],"no-global-assign","no-unsafe-negation"]