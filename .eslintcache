rorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"95","messages":"96","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"97","messages":"98","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"99","messages":"100","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"103","messages":"104","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"105","messages":"106","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"113","messages":"114","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"115","messages":"116","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"117","messages":"118","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},{"filePath":"119","messages":"120","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"121","usedDeprecatedRules":"63"},{"filePath":"122","messages":"123","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"63"},"/Users/vovanguyen/Desktop/chat_project/src/index.js",["124","125"],"import React from 'react';\nimport ReactDOM from 'react-dom';\nimport { BrowserRouter as Router } from 'react-router-dom';\nimport './index.css';\nimport './scss/index.scss';\nimport App from './App';\nimport { Provider } from 'react-redux';\nimport axiosInstance from './services/api/axios_conf';\nimport { logoutAction } from './store/actions/user';\nimport reportWebVitals from './reportWebVitals';\n\nimport store from './store/store';\n\nReactDOM.render(\n  <React.StrictMode>\n    <Router>\n      <Provider store={store}>\n        <App />\n      </Provider>\n    </Router>\n  </React.StrictMode>,\n  document.getElementById('root')\n);\n\n// If you want to start measuring performance in your app, pass a function\n// to log results (for example: reportWebVitals(console.log))\n// or send to an analytics endpoint. Learn more: https://bit.ly/CRA-vitals\nreportWebVitals();\n",["126","127"],"/Users/vovanguyen/Desktop/chat_project/src/reportWebVitals.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/store.js",[],"/Users/vovanguyen/Desktop/chat_project/src/App.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/reducers/index.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/reducers/user.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/reducers/chat.js",[],"/Users/vovanguyen/Desktop/chat_project/src/middlewares/AuthMiddleware.js",[],"/Users/vovanguyen/Desktop/chat_project/src/pages/HomePage.js",[],["128","129"],"/Users/vovanguyen/Desktop/chat_project/src/components/Chat.js",["130"],"import React, { useEffect, memo } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport { useLocation } from 'react-router';\nimport {\n  getChatInfo,\n  getAdminChatInfo,\n  setCurrentChatId,\n} from '../store/actions/chat';\nimport { setUser } from '../store/actions/user';\nimport userApi from '../services/api/userApi';\nimport { socketInit } from '../store/actions/socket';\nimport Sidebar from './Sidebar';\nimport MessagesHistory from './MessagesHistory';\nimport ChatsList from './ChatsList';\nimport MembersList from './MembersList';\n\nconst Chat = () => {\n  const location = useLocation();\n  const dispatch = useDispatch();\n  const {\n    currentChatId,\n    currentChat,\n    chat,\n    socket,\n    user,\n    userRole,\n  } = useSelector(({ chat, socket, user }) => ({\n    chat: chat.data,\n    currentChat: chat.currentChat,\n    currentChatId: chat.currentChatId,\n    socket: socket.io,\n    user: user.data,\n    userRole: user.data?.role?.name,\n  }));\n\n  useEffect(() => {\n    if (location.pathname.split('/')[1] === 'chat') {\n      dispatch(setCurrentChatId(location.pathname.split('/').pop()));\n    } else {\n      dispatch(setCurrentChatId(''));\n    }\n  }, [location, dispatch]);\n\n  useEffect(() => {\n    if (!user) {\n      userApi.getUser().then((data) => {\n        dispatch(setUser(data));\n        dispatch(socketInit());\n      });\n    }\n  }, [user, dispatch]);\n\n  useEffect(() => {\n    let data;\n    if (!chat) {\n      if (userRole === 'Admin') {\n        data = dispatch(getAdminChatInfo());\n      }\n      if (userRole === 'Client') {\n        data = dispatch(getChatInfo());\n      }\n    }\n  }, [chat, userRole, dispatch]);\n\n  return (\n    <div className='chat'>\n      <Sidebar />\n      {currentChatId ? (\n        <MessagesHistory\n          socket={socket}\n          chat={chat}\n          currentChat={currentChat}\n          currentChatId={currentChatId}\n          userRole={userRole}\n        />\n      ) : (\n        <div className='messages__empty'>Choose chat to start messaging</div>\n      )}\n\n      <div className='chat__dialogs'>\n        {userRole === 'Admin' && (\n          <ChatsList chats={chat} currentChatId={currentChatId} />\n        )}\n        {userRole === 'Client' && (\n          <MembersList members={currentChat?.members} />\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default memo(Chat);\n","/Users/vovanguyen/Desktop/chat_project/src/components/signIn.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/MessagesHistory.js",["131"],"import React, { useMemo } from 'react';\nimport Topbar from './Topbar';\nimport MessagesList from './MessagesList';\nimport ChatInput from './ChatInput';\n\nconst MessagesHistory = ({\n  socket,\n  chat,\n  userRole,\n  currentChat,\n  currentChatId,\n}) => {\n  return (\n    <div className='messages__history'>\n      <Topbar chat={currentChat} />\n\n      {currentChat ? (\n        <>\n          <MessagesList messages={currentChat?.messages} />\n          <ChatInput chat={currentChat} socket={socket} userRole={userRole} />\n        </>\n      ) : (\n        <div className='messages__empty'></div>\n      )}\n    </div>\n  );\n};\n\nexport default MessagesHistory;\n","/Users/vovanguyen/Desktop/chat_project/src/components/Sidebar.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/actions/user.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/ChatInput.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/Topbar.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/MessagesList.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/Avatar.js",[],"/Users/vovanguyen/Desktop/chat_project/src/services/api/userApi.js",[],"/Users/vovanguyen/Desktop/chat_project/src/services/api/axios_conf.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/Join.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/actions/chat.js",[],"/Users/vovanguyen/Desktop/chat_project/src/services/api/chatApi.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/actions/socket.js",[],"/Users/vovanguyen/Desktop/chat_project/src/store/reducers/socket.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/SignIn.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/ProtectedRoute.js",[],"/Users/vovanguyen/Desktop/chat_project/src/components/ChatsList.js",["132"],"import React, { useEffect } from 'react';\nimport { useDispatch } from 'react-redux';\nimport { getCurrentChatAction } from '../store/actions/chat';\nimport clsx from 'clsx';\nimport Avatar from './Avatar';\n\nconst ChatsList = ({ chats, currentChatId }) => {\n  const dispatch = useDispatch();\n  const handleChatClick = (id) => () => {\n    dispatch(getCurrentChatAction(id));\n  };\n  return (\n    <div className='chats'>\n      {chats &&\n        chats.map((chat) => {\n          return (\n            <div\n              className={clsx('chats__item', {\n                'chats__item--active': currentChatId === chat._id,\n              })}\n              key={chat._id}\n              onClick={handleChatClick(chat._id)}\n            >\n              <div className='chats__item-content'>\n                <h3>{chat.name}</h3>\n              </div>\n              <Avatar name={chat.name} />\n            </div>\n          );\n        })}\n    </div>\n  );\n};\n\nexport default ChatsList;\n","/Users/vovanguyen/Desktop/chat_project/src/components/MembersList.js",[],{"ruleId":"133","severity":1,"message":"134","line":8,"column":8,"nodeType":"135","messageId":"136","endLine":8,"endColumn":21},{"ruleId":"133","severity":1,"message":"137","line":9,"column":10,"nodeType":"135","messageId":"136","endLine":9,"endColumn":22},{"ruleId":"138","replacedBy":"139"},{"ruleId":"140","replacedBy":"141"},{"ruleId":"138","replacedBy":"142"},{"ruleId":"140","replacedBy":"143"},{"ruleId":"133","severity":1,"message":"144","line":60,"column":9,"nodeType":"135","messageId":"136","endLine":60,"endColumn":13},{"ruleId":"133","severity":1,"message":"145","line":1,"column":17,"nodeType":"135","messageId":"136","endLine":1,"endColumn":24},{"ruleId":"133","severity":1,"message":"146","line":1,"column":17,"nodeType":"135","messageId":"136","endLine":1,"endColumn":26},"no-unused-vars","'axiosInstance' is defined but never used.","Identifier","unusedVar","'logoutAction' is defined but never used.","no-native-reassign",["147"],"no-negated-in-lhs",["148"],["147"],["148"],"'data' is assigned a value but never used.","'useMemo' is defined but never used.","'useEffect' is defined but never used.","no-global-assign","no-unsafe-negation"]